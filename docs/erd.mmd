erDiagram
    roles ||--o{ users : "has"
    users ||--o| customers : "customer profile"
    users o|--o{ riders : "optional account"
    users ||--o{ notifications : "receives"
    customers o|--o{ addresses : "saves or snapshots"
    customers ||--o{ orders : "places"
    riders o|--o{ orders : "internal rider assignment"
    addresses ||--o{ orders : "pickup address"
    addresses ||--o{ orders : "dropoff address"
    orders ||--o{ parcels : "contains"
    orders ||--o{ payments : "payment records"
    orders ||--o{ deliveries : "status history"
    orders o|--o{ notifications : "optional order alert"
    orders ||--o{ delivery_control_passes : "issues links"
    orders ||--o{ delivery_change_requests : "receives requests"
    users o|--o{ delivery_change_requests : "optional reviewer"
    orders ||--o| dispatch_recovery_locks : "booking lock"

    roles {
        int id PK
        varchar name UK
        varchar description "nullable"
        datetime created_at
    }

    users {
        bigint id PK
        int role_id FK
        varchar name
        varchar email UK
        varchar phone "nullable"
        varchar password
        text fcm_token "nullable"
        enum status
        datetime created_at
        datetime updated_at
    }

    customers {
        bigint id PK
        bigint user_id FK,UK
        varchar company_name "nullable"
        varchar default_contact_phone "nullable"
        datetime created_at
        datetime updated_at
    }

    riders {
        bigint id PK
        bigint user_id FK "nullable"
        varchar name
        varchar phone
        varchar vehicle_type
        varchar plate_number
        enum status
        datetime created_at
        datetime updated_at
    }

    addresses {
        bigint id PK
        bigint customer_id FK "nullable"
        varchar label "nullable"
        text address_line
        decimal latitude "nullable"
        decimal longitude "nullable"
        varchar contact_name
        varchar contact_phone
        text notes "nullable"
        datetime created_at
    }

    orders {
        bigint id PK
        varchar order_no UK
        bigint customer_id FK
        bigint rider_id FK "nullable"
        bigint pickup_address_id FK
        bigint dropoff_address_id FK
        enum status "draft, pending_payment, paid, booking, rider_assigned, picked_up, delivered, cancelled, failed"
        decimal distance_km
        int estimated_duration_min
        decimal delivery_fee
        varchar lalamove_quotation_id "nullable"
        varchar lalamove_order_id "nullable"
        varchar courier_driver_id "nullable"
        varchar courier_driver_name "nullable"
        varchar courier_driver_phone "nullable"
        varchar courier_driver_vehicle "nullable"
        text share_link "nullable"
        text cancel_reason "nullable"
        datetime created_at
        datetime updated_at
    }

    parcels {
        bigint id PK
        bigint order_id FK
        varchar description
        decimal weight_kg
        enum size
        boolean is_fragile
        datetime created_at
    }

    payments {
        bigint id PK
        bigint order_id FK
        varchar paymongo_session_id "nullable"
        varchar paymongo_payment_id "nullable"
        decimal amount
        decimal fee
        varchar payment_method "nullable"
        enum status "pending, paid, failed, refunded, cancelled"
        datetime paid_at "nullable"
        datetime created_at
        datetime updated_at
    }

    deliveries {
        bigint id PK
        bigint order_id FK
        varchar from_status "nullable"
        varchar to_status
        text notes "nullable"
        varchar actor_type
        bigint actor_id "nullable"
        datetime created_at
    }

    notifications {
        bigint id PK
        bigint user_id FK
        bigint order_id FK "nullable"
        enum channel "sms, push"
        varchar recipient
        text message
        enum status "pending, sent, failed"
        text provider_response "nullable"
        datetime sent_at "nullable"
        datetime created_at
    }

    service_areas {
        bigint id PK
        varchar name
        longtext polygon_json
        decimal base_delivery_fee
        decimal free_distance_km
        decimal per_km_rate
        decimal free_weight_kg
        decimal per_kg_rate
        boolean is_active
        datetime created_at
        datetime updated_at
    }

    delivery_control_passes {
        bigint id PK
        bigint order_id FK
        char token_hash UK
        datetime expires_at
        datetime revoked_at "nullable"
        datetime created_at
    }

    delivery_change_requests {
        bigint id PK
        bigint order_id FK
        enum request_type "instruction, hold"
        text request_text "nullable"
        enum status "pending, applied, accepted, rejected"
        varchar source
        bigint reviewed_by FK "nullable"
        datetime reviewed_at "nullable"
        datetime created_at
    }

    dispatch_recovery_locks {
        bigint order_id PK,FK
        datetime started_at
    }

    api_logs {
        bigint id PK
        varchar service
        varchar method
        varchar endpoint
        text request_headers "nullable"
        longtext request_body "nullable"
        int response_status "nullable"
        text response_headers "nullable"
        longtext response_body "nullable"
        int execution_time_ms "nullable"
        text error_message "nullable"
        tinyint attempt
        datetime created_at
    }

    %% Schema unique index: (provider, event_id) prevents duplicate webhook processing.
    webhook_events {
        bigint id PK
        varchar provider
        varchar event_id
        varchar event_type "nullable"
        longtext payload
        enum status "received, processed, ignored, failed"
        datetime processed_at "nullable"
        datetime created_at
    }

    settings {
        int id PK
        varchar setting_key UK
        text setting_value
        varchar description "nullable"
        datetime updated_at
    }
