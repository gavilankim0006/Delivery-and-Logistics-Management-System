AddDefaultCharset UTF-8
<IfModule mod_rewrite.c>
    RewriteEngine On

    # --------------------------------------------------
    # Allow index.php
    <Files "index.php">
        Require all granted
    </Files>

    # --------------------------------------------------
    # Deny access to sensitive directories
    RedirectMatch 403 ^/(app|scheme|console|runtime)/

    # --------------------------------------------------
    # Deny access to sensitive files
    <FilesMatch "\.(env|json|xml|log|md|lock|git|ini|bak|sql)$|^(package\.json|package-lock\.json|vite\.config\.js)$">
        Require all denied
    </FilesMatch>

    # --------------------------------------------------
    # Prevent directory browsing
    Options -Indexes

    # --------------------------------------------------
    # Serve public assets directly; route app requests through the public front controller.
    RewriteRule ^public/ - [L]
    RewriteRule ^(.*)$ public/$1 [L,QSA]
</IfModule>
