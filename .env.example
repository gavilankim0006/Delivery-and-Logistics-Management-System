# Application Settings
APP_NAME="Delivery & Logistics System"
APP_KEY=
APP_ENV=development
BASE_URL=http://localhost/SIAproject/

# Database Configuration
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=delivery_logistics
DB_CHARSET=utf8mb4
DB_PREFIX=

# For API
JWT_SECRET=
REFRESH_TOKEN_KEY=

# Google Maps Platform
GOOGLE_MAPS_API_KEY=
# Separate referrer-restricted browser key for the admin polygon editor (Maps JavaScript API)
GOOGLE_MAPS_MAPS_JS_API_KEY=

# Courier provider: mock is ready immediately; choose lalamove only for optional sandbox testing.
COURIER_DRIVER=mock

# Optional Lalamove v3 Sandbox (not required when COURIER_DRIVER=mock)
LALAMOVE_API_KEY=
LALAMOVE_API_SECRET=
LALAMOVE_BASE_URL=https://rest.sandbox.lalamove.com
LALAMOVE_MARKET=PH
LALAMOVE_WEBHOOK_SECRET=
# Keep unset/0 until partner webhook authentication and payload rules are verified.
LALAMOVE_WEBHOOK_AUTH_CONFIRMED=0

# PayMongo Test Mode (checkout rejects live keys)
PAYMONGO_SECRET_KEY=
PAYMONGO_PUBLIC_KEY=
PAYMONGO_BASE_URL=https://api.paymongo.com/v1
PAYMONGO_WEBHOOK_SECRET=

# Semaphore SMS (sending is opt-in per user and disabled unless explicitly enabled)
SEMAPHORE_ENABLED=0
SEMAPHORE_API_KEY=
SEMAPHORE_SENDER_NAME=SEMAPHORE
SEMAPHORE_BASE_URL=https://api.semaphore.co/api/v4

# Firebase Cloud Messaging
FIREBASE_PUSH_ENABLED=0
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Alternative: path to the service account JSON file (overrides individual env vars above)
FIREBASE_CREDENTIALS_PATH=
FIREBASE_VAPID_KEY=

# Gemini Assistant Configuration
# Comma-, semicolon-, or newline-separated API keys; keys may belong to separate Google accounts.
# On quota/rate-limit/auth failures, service retries using another configured key.
GEMINI_API_KEYS=
# Optional single-key shorthand
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Email Notification Configuration (falls back to PHP mail() and runtime/logs/email.log)
#
# IMPORTANT: Hosts like Render (free tier) block outbound SMTP ports 25/465/587, so
# smtp.gmail.com will time out there even though it works on localhost. On such hosts
# send over an HTTPS email API instead (port 443 is never blocked).
#
# Option A - HTTP API (recommended for Render/Railway/Vercel/etc.):
#   MAIL_MAILER: resend | brevo | sendgrid | mailgun | mailtrap | api
#   MAIL_API_KEY: provider API key. For Gmail-based sending with Resend, verify your
#                 address/domain at https://resend.com and use a verified MAIL_FROM_ADDRESS.
#   MAIL_API_ENDPOINT: optional override; required for Mailgun ({domain} is substituted
#                      from MAIL_FROM_ADDRESS, e.g. https://api.mailgun.net/v3/{domain}/messages)
MAIL_MAILER=smtp
MAIL_API_KEY=
MAIL_API_ENDPOINT=

# Option B - Direct SMTP (works on localhost and paid hosts with SMTP ports open):
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls

MAIL_FROM_ADDRESS=noreply@omniroute.local
MAIL_FROM_NAME="Dispatch Delivery & Logistics"
